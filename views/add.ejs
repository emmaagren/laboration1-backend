<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lägg till kurs</title>
    <link rel="stylesheet" href="/style.css">
</head>


<body>
    <header>
        <h1>Mitt digitala CV</h1>

        <nav>
            <a href="/">Mina kurser</a>
            <a href="/add">Lägg till kurs</a>
            <a href="/about">Om sidan</a>
        </nav>
    </header>

    <main>
        <h2>Lägg till kurs</h2>

        <% if (error) { %>
        <p class="error"><%= error %></p>
        <% } %>

        <form action="/add" method="POST">

            <label for="coursecode">Kurskod:</label>
            <input type="text" id="coursecode" name="coursecode" required>

            <label for="coursename">Kursnamn:</label>
            <input type="text" id="coursename" name="coursename" required>

            <label for="syllabus">Kursplan (URL):</label>
            <input type="url" id="syllabus" name="syllabus" required>

            <label for="progression">Kursprogression:</label>
            <select id="progression" name="progression" required>
                <option value="">Välj progression</option>
                <option value="A">A</option>
                <option value="B">B</option>
                <option value="C">C</option>
            </select>

            <button type="submit">Lägg till kurs</button>
            </form>
    </main>
    
</body>
</html>